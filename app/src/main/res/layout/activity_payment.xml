<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF">

    <ImageButton
        android:id="@+id/btnBackPayment"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="Quay lại"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvPaymentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Thanh Toán"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="@id/btnBackPayment"
        app:layout_constraintBottom_toBottomOf="@id/btnBackPayment"
        app:layout_constraintStart_toEndOf="@id/btnBackPayment"/>

    <TextView
        android:id="@+id/tvTotalAmount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Cần thanh toán: 0 VNĐ"
        android:textSize="22sp"
        android:textColor="#4CAF50"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnBackPayment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <RadioGroup
        android:id="@+id/rgPaymentMethods"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTotalAmount"> <RadioButton
        android:id="@+id/rbCash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tiền mặt"
        android:textSize="18sp"
        android:checked="true"
        android:padding="12dp"/>

        <RadioButton
            android:id="@+id/rbQR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chuyển khoản (VietQR)"
            android:textSize="18sp"
            android:padding="12dp"/>
    </RadioGroup>

    <ImageView
        android:id="@+id/imgVietQR"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:src="@drawable/my_qr_code"
        app:layout_constraintTop_toBottomOf="@id/rgPaymentMethods"
        app:layout_constraintBottom_toTopOf="@id/btnConfirmPayment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnConfirmPayment"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:text="Xác nhận thanh toán"
        android:textSize="18sp"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>